generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}
enum TrackingStatus {
 CLICKED
 LOGIN_SUCCESS
 VERIFIED_FRIEND
 VERIFIED_NEW_FRIEND
 EXISTING_FRIEND
 UNBLOCKED
 NOT_FRIEND
 PENDING_REVIEW
 REJECTED
}
enum CommissionStatus {
 Pending
 Approved
 Paid
 Rejected
}
model Affiliate {
 id String @id @default(cuid())
 code String @unique
 name String
 notes String @default("")
 active Boolean @default(true)
 rateSatang Int @default(500)
 archivedAt DateTime?
 salesCommissionBasis String @default("REVENUE")
 salesCommissionBps Int @default(0)
 salesCommissionTransferBps Int?
 salesCommissionCodBps Int?
 createdAt DateTime @default(now())
 accounts UserAccount[]
 link TrackingLink?
 clicks Click[]
 conversions Conversion[]
 customers Customer[]
}
model TrackingLink {
 id String @id @default(cuid())
 affiliateId String @unique
 affiliate Affiliate @relation(fields:[affiliateId], references:[id])
 clicks Click[]
}
model Click {
 id String @id @default(cuid())
 affiliateId String
 affiliate Affiliate @relation(fields:[affiliateId],references:[id])
 linkId String
 link TrackingLink @relation(fields:[linkId],references:[id])
 createdAt DateTime @default(now())
 userKey String?
 loginAt DateTime?
 metaFbc String?
 customerLanding Boolean @default(false)
 customerEnteredAt DateTime?
 marketingCustomerCode String?
 source String @default("LINE")
 loginResult String @default("NOT_STARTED")
 status TrackingStatus @default(CLICKED)
 oauth OAuthAttempt[]
 conversion Conversion?
 @@index([createdAt, affiliateId])
 @@index([userKey])
 @@index([customerLanding, customerEnteredAt])
}
model OAuthAttempt {
 id String @id @default(cuid())
 lineRevision String?
 stateHash String @unique
 browserHash String
 verifier String
 nonce String
 purpose String @default("AFFILIATE")
 customerLinkHash String?
 clickId String?
 click Click? @relation(fields:[clickId],references:[id])
 expiresAt DateTime
 consumedAt DateTime?
}
model CustomerAccessLink {
 tokenHash String @id
 customerCode String
 createdBy String
 expiresAt DateTime?
 usedAt DateTime?
 customer Customer @relation(fields:[customerCode],references:[code],onDelete:Cascade)
}
model Conversion {
 id String @id @default(cuid())
 customerCode String @unique @default(dbgenerated("customer_code()"))
 customerProfile Customer?
 source String @default("LINE")
 userKey String @unique
 clickId String @unique
 click Click @relation(fields:[clickId],references:[id])
 affiliateId String
 affiliate Affiliate @relation(fields:[affiliateId],references:[id])
 friendFlag Boolean?
 friendshipChanged Boolean?
 status TrackingStatus @default(PENDING_REVIEW)
 reason String
 rateSatang Int
 createdAt DateTime @default(now())
 verifiedAt DateTime?
 commission Commission?
 history StatusHistory[]
}
model StatusHistory {
 id String @id @default(cuid())
 conversionId String
 conversion Conversion @relation(fields:[conversionId],references:[id])
 status TrackingStatus
 reason String
 createdAt DateTime @default(now())
}
model WebhookEvent {
 id String @id
 userKey String
 type String
 eventAt DateTime
 receivedAt DateTime @default(now())
 isUnblocked Boolean?
 @@index([userKey,eventAt])
}
model Commission {
 @@index([status,paidAt])
 id String @id @default(cuid())
 conversionId String @unique
 conversion Conversion @relation(fields:[conversionId],references:[id])
 status CommissionStatus @default(Pending)
 amountSatang Int
 paidAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model AuditLog {
