generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}
enum TrackingStatus {
 CLICKED
 LOGIN_SUCCESS
 VERIFIED_FRIEND
 VERIFIED_NEW_FRIEND
 EXISTING_FRIEND
 UNBLOCKED
 NOT_FRIEND
 PENDING_REVIEW
 REJECTED
}
enum CommissionStatus {
 Pending
 Approved
 Paid
 Rejected
}
model Affiliate {
 id String @id @default(cuid())
 code String @unique
 name String
 notes String @default("")
 active Boolean @default(true)
 rateSatang Int @default(500)
 archivedAt DateTime?
 salesCommissionBasis String @default("REVENUE")
 salesCommissionBps Int @default(0)
 createdAt DateTime @default(now())
 accounts UserAccount[]
 link TrackingLink?
 clicks Click[]
 conversions Conversion[]
}
model TrackingLink {
 id String @id @default(cuid())
 affiliateId String @unique
 affiliate Affiliate @relation(fields:[affiliateId], references:[id])
 clicks Click[]
}
model Click {
 id String @id @default(cuid())
 affiliateId String
 affiliate Affiliate @relation(fields:[affiliateId],references:[id])
 linkId String
 link TrackingLink @relation(fields:[linkId],references:[id])
 createdAt DateTime @default(now())
 userKey String?
 loginAt DateTime?
 metaFbc String?
 source String @default("LINE")
 loginResult String @default("NOT_STARTED")
 status TrackingStatus @default(CLICKED)
 oauth OAuthAttempt[]
 conversion Conversion?
 @@index([createdAt, affiliateId])
 @@index([userKey])
}
model OAuthAttempt {
 id String @id @default(cuid())
 lineRevision String?
 stateHash String @unique
 browserHash String
 verifier String
 nonce String
 clickId String
 click Click @relation(fields:[clickId],references:[id])
 expiresAt DateTime
 consumedAt DateTime?
}
model Conversion {
 id String @id @default(cuid())
 source String @default("LINE")
 userKey String @unique
 clickId String @unique
 click Click @relation(fields:[clickId],references:[id])
 affiliateId String
 affiliate Affiliate @relation(fields:[affiliateId],references:[id])
 friendFlag Boolean?
 friendshipChanged Boolean?
 status TrackingStatus @default(PENDING_REVIEW)
 reason String
 rateSatang Int
 createdAt DateTime @default(now())
 verifiedAt DateTime?
 commission Commission?
 history StatusHistory[]
}
model StatusHistory {
 id String @id @default(cuid())
 conversionId String
 conversion Conversion @relation(fields:[conversionId],references:[id])
 status TrackingStatus
 reason String
 createdAt DateTime @default(now())
}
model WebhookEvent {
 id String @id
 userKey String
 type String
 eventAt DateTime
 receivedAt DateTime @default(now())
 isUnblocked Boolean?
 @@index([userKey,eventAt])
}
model Commission {
 @@index([status,paidAt])
 id String @id @default(cuid())
 conversionId String @unique
 conversion Conversion @relation(fields:[conversionId],references:[id])
 status CommissionStatus @default(Pending)
 amountSatang Int
 paidAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model AuditLog {
 id String @id @default(cuid())
 actor String
 action String
 entityId String
 details Json
 createdAt DateTime @default(now())
}
model RateLimit {
 key String @id
 count Int @default(0)
 expiresAt DateTime
}

model LineConnection {
 id String @id
 encrypted String
 revision String
}

model UserAccount {
 username String @id
 role String
 salt String
 hash String
 version String
 active Boolean @default(true)
 affiliateId String?
 affiliate Affiliate? @relation(fields:[affiliateId],references:[id],onDelete:Restrict)
}

model MetaConnection {
 id String @id
 datasetId String
}

model OrderGroup {
 purpose String @default("ORDER")
 id String @id
 botId String
 groupId String
 name String @default("")
 enabled Boolean @default(false)
 lastSeenAt DateTime @default(now())
 createdAt DateTime @default(now())
 @@unique([botId, groupId])
}

model OrderBot {
 id String @id @default(cuid())
 name String
 botId String @unique
 encrypted String
 active Boolean @default(true)
 createdAt DateTime @default(now())
}

model OrderIntake {
 id String @id @default(cuid())
 eventKey String @unique
 messageKey String @unique
 groupKey String
 senderKey String?
 orderNumber String @unique
 rawText String?
 sellerCode String?
 sellerUsername String?
 affiliateId String?
 salesCommissionBasis String?
 salesCommissionBps Int?
 recipient String?
 phone String?
 address String?
 payment String?
 status String @default("WAITING_SHIPMENT")
 issues Json
 eventAt DateTime
 createdAt DateTime @default(now())
 withdrawnAt DateTime?
 replyStatus String @default("NOT_SENT")
 replyAttempts Int @default(0)
 replyLastError String?
 repliedAt DateTime?
 @@index([groupKey, createdAt])
 @@index([sellerUsername, createdAt])
}

model OrderMessageWithdrawal {
 messageKey String @id
 createdAt DateTime @default(now())
}

model GmailConnection {
 id String @id
 encryptedConfig String
 revision String
 encryptedToken String?
 email String?
 connectedAt DateTime?
 syncPageToken String?
 lastSyncAt DateTime?
 topicName String?
 watchExpiresAt DateTime?
 historyId String?
 lastPushAt DateTime?
}

model GmailImport {
 id String @id
 messageId String
 filename String
 subject String
 kind String
 rowCount Int
 reportAt DateTime
 importedAt DateTime @default(now())
 @@unique([messageId, filename])
}

model Shipment {
 freightSatang Int?
 totalChargeSatang Int?
 freightReportAt DateTime?
 freightImportId String?
 tracking String @id
 importId String
 recipient String
 phone String
 address String
 codSatang Int
 reportAt DateTime
 orderId String? @unique
 status String @default("WAITING_ORDER")
 fulfillmentStatus String @default("UNCONFIRMED")
 dispatchedAt DateTime?
 dispatchEvidence String?
 dispatchConfirmedBy String?
 @@index([fulfillmentStatus, dispatchedAt])
 createdAt DateTime @default(now())
}

model CodReceipt {
 tracking String @id
 importId String
 amountSatang Int
 reportAt DateTime
}

model SalesOrder {
 id String @id @default(cuid())
 orderId String @unique
 tracking String? @unique
 paymentMethod String @default("COD")
 paymentEvidence String @default("SHIPMENT_REPORT")
 affiliateId String
 revenueSatang Int
 commissionBasis String
 commissionBps Int
 commissionSatang Int?
 status String
 paidAt DateTime?
 paidAmountSatang Int?
 recognizedAt DateTime?
 createdAt DateTime @default(now())
 @@index([recognizedAt, status])
}

model GmailOAuthAttempt {
 stateHash String @id
 browserHash String
 actor String
 actorVersion String
 revision String
 verifier String
 expiresAt DateTime
 consumedAt DateTime?
}

model StockHistoryConfig {
 id String @id
 enabled Boolean @default(true)
 startDay String
 createdAt DateTime @default(now())
}
model StockDailySnapshot {
 day String @id
 actor String
 sourceSheet String
 capturedAt DateTime
 products Json
 rows Json
 fingerprint String
 sheetId Int @unique
 sheetTitle String @unique
 status String @default("PENDING")
 exportedAt DateTime?
 createdAt DateTime @default(now())
}

model StockProduct {
 issuedQuantity Decimal? @db.Decimal(18, 3)
 remainingQuantity Decimal? @db.Decimal(18, 3)
 salePrices Json @default("[]")
 receivedQuantity Decimal? @db.Decimal(18, 3)
 id String @id @default(cuid())
 code String @unique
 name String?
 costSatang Int?
 sourceUrl String
 sourceSheet String
 sourceRow Int
 importedAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model StockProductUpdate {
 id String @id
 fingerprint String
 code String
 actor String
 sourceSheet String
 before Json
 after Json
 status String @default("PENDING")
 createdAt DateTime @default(now())
 completedAt DateTime?
}
model StockDeleteBatch {
 id String @id
 fingerprint String
 actor String
 sourceSheet String
 items Json
 status String @default("PENDING")
 createdAt DateTime @default(now())
 completedAt DateTime?
}
model StockSheetsConnection {
 id String @id
 encryptedConfig String
 email String
 revision String
 connectedAt DateTime @default(now())
}

model StockIntegrationConfig {
 id String @id
 enabled Boolean @default(false)
 activeFrom DateTime
 createdAt DateTime @default(now())
}

model StockWorkflow {
 id String @id
 enabled Boolean @default(false)
 activeFrom DateTime @default(now())
 sourceSheet String
}
model StockReservation {
 orderId String @id
 messageKey String @unique
 orderNumber String
 actor String
 items Json
 status String @default("QUEUED")
 issues Json @default("[]")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model StockSheetOperation {
 id String @id
 kind String
 sourceSheet String
 snapshot Json
 fingerprint String
 status String @default("PREPARED")
 createdAt DateTime @default(now())
 appliedAt DateTime?
}
model StockDispatch {
 id String @id @default(cuid())
 orderId String @unique
 orderNumber String
 candidateTracking String?
 tracking String? @unique
 payment String?
 status String @default("PENDING")
 issues Json @default("[]")
 items Json @default("[]")
 totalCostSatang Int?
 sourceSheet String?
 dispatchedAt DateTime?
 processedAt DateTime?
 historySnapshot Json?
 historySavedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,dispatchedAt])
}

model Expense {
 items Json @default("[]")
 replyStatus String @default("NOT_SENT")
 replyAttempts Int @default(0)
 repliedAt DateTime?
 replyLastError String?
 id String @id @default(cuid())
 messageKey String @unique
 eventKey String @unique
 groupKey String
 expenseNumber String @unique
 description String?
 amountSatang Int?
 bankName String?
 bankAccount String?
 recipient String?
 rawText String?
 status String
 issues Json
 eventAt DateTime
 paidAt DateTime?
 createdAt DateTime @default(now())
 @@index([paidAt,status])
 @@index([groupKey,eventAt])
}
model RecurringExpense {
 id String @id @default(cuid())
 requestKey String @unique
 description String
 amountSatang Int
 startMonth String
 lastGeneratedMonth String?
 createdBy String
 archivedAt DateTime?
 createdAt DateTime @default(now())
 entries RecurringExpenseEntry[]
}
model RecurringExpenseEntry {
 id String @id @default(cuid())
 recurringExpenseId String
 recurringExpense RecurringExpense @relation(fields:[recurringExpenseId],references:[id])
 month String
 description String
 amountSatang Int
 incurredAt DateTime
 status String @default("RECORDED")
 voidedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([recurringExpenseId,month])
 @@index([incurredAt,status])
}
