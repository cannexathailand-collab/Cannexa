 reviewedBy String?
 reviewedAt DateTime?
 intakeOrderId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([customerCode,requestKey])
 @@index([status,createdAt])
 @@index([customerCode,createdAt])
}

