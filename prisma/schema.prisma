model Customer {
 customerCategory String?
 businessLicenseNumber String?
 portalRegistrationPending Boolean @default(false)
 portalProfileIncomplete Boolean @default(false)
 portalUsername String? @unique
  discoverySource String?
  registrationPhone String?
   profileResetAt DateTime?
   registeredAt DateTime?
 portalPasswordSalt String?
 portalPasswordHash String?
 code String @id @default(dbgenerated("customer_code()"))
 lineUserKey String? @unique
 conversionId String? @unique
 conversion Conversion? @relation(fields:[conversionId],references:[id],onDelete:Restrict)
 identityKey String? @unique
 title String?
 name String?
 phone String?
 address String?
 referrerId String?
 referrer Affiliate? @relation(fields:[referrerId],references:[id],onDelete:Restrict)
 metaFbc String?
