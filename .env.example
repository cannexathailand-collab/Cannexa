# Copy to .env; never commit secrets. MOCK_MODE is forbidden in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affiliate?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/affiliate?schema=public"
APP_URL="http://localhost:3000"
MOCK_MODE="true"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
USER_HASH_SECRET=""
ADMIN_PASSWORD_SALT=""
# scrypt(password, salt, 64 bytes); use scripts/setup-secrets.mjs
ADMIN_PASSWORD_HASH=""
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
LINE_MESSAGING_CHANNEL_SECRET=""
LINE_OA_BASIC_ID=""
# Verify the destination user ID in webhook payload; get from LINE console
LINE_BOT_USER_ID=""
PRIVACY_CONTACT="privacy@example.com"
RETENTION_DAYS="180"
